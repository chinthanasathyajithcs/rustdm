{
  "manifest_version": 3,
  "name": "rustdm",
  "version": "0.1.0",
  "description": "Sends your browser's downloads to rustdm, the resilient download manager.",
  "minimum_chrome_version": "110",
  "incognito": "not_allowed",
  "key": "",
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "contextMenus",
    "scripting",
    "storage",
    "webRequest"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "rustdm",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "panel.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
